ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = ROOT / "config.json"
EXAMPLE_CONFIG = ROOT / "config.example.json"


def bootstrap_openclaw_agent_env():
    """Preserve the per-subagent lark-cli route before the script changes cwd."""
    if os.environ.get("OPENCLAW_AGENT_DIR"):
        return
    match = re.match(r"^(.*/\.openclaw)/workspaces/([^/]+)", os.getcwd().replace("\\", "/"))
    if not match:
        return
    openclaw_root, agent_id = match.groups()
    os.environ["OPENCLAW_AGENT_ID"] = agent_id
    os.environ["OPENCLAW_AGENT_DIR"] = str(Path(openclaw_root) / "agents" / agent_id)


def resolve_lark_cli() -> str:
    agent_dir = os.environ.get("OPENCLAW_AGENT_DIR", "")
    if agent_dir:
        agent_lark_cli = Path(agent_dir) / "lark-cli"
        if agent_lark_cli.exists() and os.access(agent_lark_cli, os.X_OK):
            return str(agent_lark_cli)
    return "lark-cli"


def load_config(path: str | None) -> dict:
    config_path = Path(path) if path else DEFAULT_CONFIG
    if not config_path.exists():
        config_path = EXAMPLE_CONFIG
    return json.loads(config_path.read_text(encoding="utf-8"))


def parse_args():
    parser = argparse.ArgumentParser(description="生成个人工作早报卡片")
    parser.add_argument("--report-date", "--date", dest="report_date", help="详细日报日期 YYYY-MM-DD，默认昨天")
    parser.add_argument("--card-date", help="早报日期 YYYY-MM-DD，默认今天或日报次日")
    parser.add_argument("--config", help="配置文件路径")
    parser.add_argument("--run-dir", help="输出目录")
    parser.add_argument("--open", action="store_true", help="生成后打开 card.jpg")
    parser.add_argument("--send", action="store_true", help="生成后通过飞书机器人发送 card.jpg")
    parser.add_argument("--no-send", action="store_true", help="即使配置开启 delivery.enabled，也不发送")
    return parser.parse_args()


def dates(args, config):
    tz = ZoneInfo(config.get("timezone", "Asia/Shanghai"))
    if args.report_date:
        report_day = datetime.strptime(args.report_date, "%Y-%m-%d").date()
    else:
        report_day = datetime.now(tz).date() - timedelta(days=1)
    if args.card_date:
        card_day = datetime.strptime(args.card_date, "%Y-%m-%d").date()
    else:
        card_day = report_day + timedelta(days=1)
    card_start = datetime.combine(card_day, datetime.min.time()).replace(tzinfo=tz)
    card_end = card_start.replace(hour=23, minute=59, second=59)
    return {
        "report_date": report_day.isoformat(),
        "card_date": card_day.isoformat(),
        "card_start_iso": card_start.isoformat(),
        "card_end_iso": card_end.isoformat(),
        "card_date_cn": f"{card_day.year}年{card_day.month:02d}月{card_day.day:02d}日",
        "report_date_header": f"{report_day.year}年{report_day.month}月{report_day.day}日",
        "weekday_cn": "一二三四五六日"[card_day.weekday()],
    }


def output_dir(config, card_date: str, explicit: str | None) -> Path:
    if explicit:
        path = Path(explicit)
    else:
        runs_root = (
            os.environ.get("WORKDAY_MORNING_CARD_RUN_ROOT")
            or config.get("runs_dir")
            or openclaw_workspace_runs_root("workday-morning-card")
            or ROOT / "runs"
        )
        path = Path(runs_root) / card_date
    if not path.is_absolute():
        path = ROOT / path
    path.mkdir(parents=True, exist_ok=True)
    return path


def openclaw_workspace_runs_root(skill_name: str) -> Path | None:
    match = re.match(r"^(.*/\.openclaw/workspaces/[^/]+)", os.getcwd().replace("\\", "/"))
    if not match:
        return None
    return Path(match.group(1)) / "run" / skill_name


def run_command(command: list[str], stdin: str | None = None, timeout: int = 180) -> dict:
    shell = False
    executable = command
    if command and command[0] == "lark-cli":
        command = [resolve_lark_cli(), *command[1:]]
        shell = True
        executable = " ".join(shlex.quote(part) for part in command)
    result = subprocess.run(
        executable,
        input=stdin,
        shell=shell,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=timeout,
    )
    parsed = None
    try:
        parsed = json.loads(result.stdout)
    except json.JSONDecodeError:
        parsed = None
    return {
        "ok": result.returncode == 0,
        "returncode": result.returncode,
        "stdout": result.stdout[-8000:],
        "stderr": result.stderr[-8000:],
        "json": parsed,
    }


def run_shell_template(command: str, values: dict, timeout: int = 180) -> dict:
    if not command.strip():
        return {"ok": True, "skipped": True, "items": []}
    rendered = command.format(**values)
    rendered = re.sub(r"(^|\s)lark-cli(?=\s|$)", lambda m: m.group(1) + shlex.quote(resolve_lark_cli()), rendered, count=1)
    result = subprocess.run(
        rendered,
        shell=True,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=timeout,
    )
    parsed = parse_json(result.stdout)
    return {
        "ok": result.returncode == 0,
        "command": rendered,
        "returncode": result.returncode,
        "stdout": result.stdout[-8000:],
        "stderr": result.stderr[-8000:],
        "json": parsed,
        "items": normalize_items(parsed),
    }


def parse_json(text: str):
    if not text.strip():
        return {}
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"(\{.*\}|\[.*\])", text, flags=re.S)
        if match:
            try:
                return json.loads(match.group(1))
            except json.JSONDecodeError:
                pass
    return {"text": text.strip()}


def normalize_items(value):
    if isinstance(value, list):
        return value
    if isinstance(value, dict):
        for key in ("items", "events", "tasks", "records", "messages", "data"):
            inner = value.get(key)
            if isinstance(inner, list):
                return inner
            if isinstance(inner, dict):
                items = normalize_items(inner)
                if items:
                    return items
        return [value] if value else []
    return []


def excel_col_index(name: str) -> int:
    value = 0
    for char in name.upper():
        value = value * 26 + ord(char) - 64
    return value


def parse_annotated_csv_rows(data: dict) -> list[dict]:
    annotated = data.get("annotated_csv") or data.get("csv") or data.get("text") or ""
    if not annotated:
        return []
    col_indices = data.get("col_indices") or []
    rows = []
    matches = list(re.finditer(r"(?m)^\[row=(\d+)\]\s?", annotated))
    for idx, match in enumerate(matches):
        row_number = int(match.group(1))
        start = match.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(annotated)
        csv_block = annotated[start:end].rstrip("\r\n")
        parsed = next(csv.reader(io.StringIO(csv_block)), [])
        values = {}
        for idx, cell in enumerate(parsed):
            col = col_indices[idx] if idx < len(col_indices) else index_to_excel_col(idx + 1)
            values[col] = cell
        rows.append({"row_number": row_number, "values": values})
    return rows


def extract_sheet_rows(payload: dict) -> list[dict]:
    data = payload.get("data", {}) if isinstance(payload, dict) else {}
    rows = data.get("rows")
    if isinstance(rows, list):
        return rows
    parsed = parse_annotated_csv_rows(data)
    if parsed:
        return parsed
    top_rows = payload.get("rows") if isinstance(payload, dict) else None
    if isinstance(top_rows, list):
        return top_rows
    return []


def index_to_excel_col(index: int) -> str:
    result = ""
    while index:
        index, rem = divmod(index - 1, 26)
        result = chr(65 + rem) + result
    return result


def resolve_spreadsheet_token(url_or_token: str) -> str:
    if "/wiki/" not in url_or_token:
        return url_or_token
    result = run_command(
        [
            "lark-cli",
            "wiki",
            "+node-get",
            "--as",
            "user",
            "--node-token",
            url_or_token,
            "--json",
        ]
    )
    if not result["ok"]:
        raise RuntimeError(f"解析 Wiki 表格失败: {result['stderr'] or result['stdout']}")
    data = result["json"].get("data", {})
    if data.get("obj_type") != "sheet":
        raise RuntimeError(f"目标 Wiki 不是电子表格: {data.get('obj_type')}")
    return data["obj_token"]


def read_report_from_sheet(config: dict, date_info: dict) -> tuple[str, dict]:
    sheet_conf = config.get("source", {}).get("daily_sheet", {})
    url = sheet_conf.get("url", "")
    if not url:
        return read_local_report(config, date_info), {"source": "local"}
    token = resolve_spreadsheet_token(url)
    workbook = run_command(["lark-cli", "sheets", "+workbook-info", "--as", "user", "--spreadsheet-token", token, "--json"])
    if not workbook["ok"]:
        raise RuntimeError(f"读取工作簿失败: {workbook['stderr'] or workbook['stdout']}")
    sheets = workbook["json"].get("data", {}).get("sheets", [])
    sheet_id = sheet_conf.get("sheet_id", "")
    if not sheet_id:
        sheet_name = sheet_conf.get("sheet_name", "")
        matched = next((s for s in sheets if sheet_name and s.get("sheet_name") == sheet_name), None)
        sheet_id = (matched or sheets[0])["sheet_id"]

    values = run_command(
        [
            "lark-cli",
            "sheets",
            "+csv-get",
            "--as",
            "user",
            "--spreadsheet-token",
            token,
            "--sheet-id",
            sheet_id,
            "--range",
            sheet_conf.get("scan_range", "A1:AZ300"),
            "--include-row-prefix",
            "--json",
        ]
    )
    if not values["ok"]:
        raise RuntimeError(f"读取日报表格失败: {values['stderr'] or values['stdout']}")
    rows = extract_sheet_rows(values["json"])
    header_row_num = int(sheet_conf.get("header_row", 2))
    header = next((r for r in rows if r.get("row_number") == header_row_num), None)
    if not header:
        raise RuntimeError(f"未找到日期表头行: {header_row_num}")
    date_col = ""
    for col, cell_value in header.get("values", {}).items():
        if str(cell_value).strip() == date_info["report_date_header"]:
            date_col = col
            break
    if not date_col:
        raise RuntimeError(f"未找到日报日期列: {date_info['report_date_header']}")

    name_col = sheet_conf.get("name_column", "B")
    dept_col = sheet_conf.get("department_column", "A")
    min_report_chars = int(sheet_conf.get("min_report_chars", 100))
    target = None
    for row in rows:
        row_number = int(row.get("row_number") or 0)
        if row_number <= header_row_num:
            continue
        vals = row.get("values", {})
        if str(vals.get(name_col, "")).strip() == config.get("person_name", ""):
            if not config.get("department") or str(vals.get(dept_col, "")).strip() == config.get("department"):
                target = row
                break
    if not target:
        raise RuntimeError(f"未找到用户行: {config.get('department')} / {config.get('person_name')}")
    report = str(target.get("values", {}).get(date_col, "")).strip()
    if not report:
        raise RuntimeError(f"目标单元格为空: {date_col}{target.get('row_number')}")
    if len(report) < min_report_chars:
        raise RuntimeError(
            f"目标单元格内容过短，疑似读到日期表头或不完整日报: "
            f"{date_col}{target.get('row_number')}，长度 {len(report)} 字符，"
            f"最小要求 {min_report_chars} 字符"
        )
    return report, {"source": "sheet", "sheet_id": sheet_id, "cell": f"{date_col}{target.get('row_number')}"}


def read_local_report(config: dict, date_info: dict) -> str:
    report_dir = config.get("source", {}).get("local_report_dir") or str(ROOT.parent / "personal-work-report" / "reports")
    path = Path(report_dir) / f"{date_info['report_date']}-工作日报.md"
    if not path.exists():
        raise FileNotFoundError(f"未找到本地详细日报，也未配置飞书表格: {path}")
    return path.read_text(encoding="utf-8")


def collect_today_sources(config: dict, date_info: dict) -> dict:
    values = dict(date_info)
    calendar_conf = config.get("calendar", {})
    task_conf = config.get("tasks", {})
    calendar = run_shell_template(calendar_conf.get("command", ""), values) if calendar_conf.get("enabled", True) else {"items": []}
    tasks = run_shell_template(task_conf.get("command", ""), values) if task_conf.get("enabled", False) else {"items": []}
    return {"calendar": calendar, "tasks": tasks}


def compact_source_item(item) -> str:
    if isinstance(item, str):
        return normalize_work_item_text(item, allow_short=True)
    if not isinstance(item, dict):
        return normalize_work_item_text(str(item), allow_short=True)

    # Calendar agenda items are meetings/events: keep only the meeting name.
    for key in ("title", "summary", "name", "subject"):
        value = item.get(key)
        if value and isinstance(value, (str, int, float)):
            return normalize_work_item_text(str(value), allow_short=True)
    raw = item.get("raw") if isinstance(item.get("raw"), dict) else {}
    for key in ("title", "summary", "name", "subject"):
        value = raw.get(key)
        if value and isinstance(value, (str, int, float)):
            return normalize_work_item_text(str(value), allow_short=True)

    parts = []
    for key in ("content", "due", "status"):
        value = item.get(key)
        if value and isinstance(value, (str, int, float)):
            parts.append(str(value))
    if not parts:
        return ""
    return normalize_work_item_text(" / ".join(parts), allow_short=True)


def call_llm(config: dict, prompt: str) -> dict | None:
    llm = config.get("llm", {})
    if llm.get("command"):
        result = run_shell_template(llm["command"], {"prompt": prompt}, timeout=180)
        if result.get("ok"):
            return parse_card_json(result.get("stdout", ""))
        return None
    api_key = os.environ.get(llm.get("api_key_env", ""))
    if not api_key or not llm.get("base_url"):
        return None
    payload = {
        "model": llm.get("model", "deepseek-v4-flash"),
        "messages": [
            {"role": "system", "content": "你是严谨的工作早报卡片助手，只输出 JSON，不编造事实。"},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0.2,
    }
    req = request.Request(
        llm["base_url"].rstrip("/") + "/v1/chat/completions",
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with request.urlopen(req, timeout=180) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        content = data["choices"][0]["message"]["content"]
        return parse_card_json(content)
    except Exception:
        return None


def parse_card_json(text: str) -> dict | None:
    match = re.search(r"\{.*\}", text, flags=re.S)
    if not match:
        return None
    try:
        return json.loads(match.group(0))
    except json.JSONDecodeError:
        return None


def split_sections(report: str) -> dict[str, str]:
    marker = re.compile(r"(?m)^(?:#{1,3}\s*)?([一二三四五六]、|[1-6][.、])\s*([^\n]+)")
    matches = list(marker.finditer(report))
    sections = {}
    for idx, match in enumerate(matches):
        key = match.group(1)
        title = clean_line(match.group(2))
        start = match.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(report)
        num = "一二三四五六".find(key[0]) + 1 if key[0] in "一二三四五六" else int(key[0])
        content = report[start:end].strip()
        sections[str(num)] = content
        sections[title] = content
    return sections


def clean_line(line: str) -> str:
    line = re.sub(r"^#{1,6}\s*", "", line.strip())
    line = re.sub(r"\*\*(.*?)\*\*", r"\1", line)
    line = re.sub(r"^[\s\-*]+", "", line.strip())
    line = re.sub(r"^[①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳]\s*", "", line)
    line = re.sub(r"^\d+\s*[.)、）:：]\s*", "", line)
    line = re.sub(r"\*+$", "", line)
    line = re.sub(r"`([^`]+)`", r"\1", line)
    line = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", line)
    line = re.sub(r"\s*/\s*\{.*$", "", line)
    line = re.sub(r"([：:])\s*[：:]+", r"\1", line)
    line = re.sub(r"\s+", " ", line)
    return line.strip("；;。 ")


def sanitize_card_text(text: str, max_chars: int | None = None) -> str:
    text = clean_line(str(text))
    text = re.sub(r"^(工作事项|重点工作事项|交付物|计划交付物|预期成果|当前状态)[：:]\s*", "", text)
    text = re.sub(r"[（(][^）)]*(?:\d{1,2}:\d{2}|约\s*\d+\s*分钟)[^）)]*[）)]", "", text)
    text = re.sub(r"([：:])\s*[：:]+", r"\1", text)
    text = text.strip("；;。 ,，")
    return truncate_at_boundary(text, max_chars) if max_chars else text


def truncate_at_boundary(text: str, max_chars: int | None, min_chars: int = 10) -> str:
    text = str(text).strip("；;。 ,，")
    if not max_chars or len(text) <= max_chars:
        return text
    head = text[:max_chars]
    boundary_chars = "，,、/／；;。"
    candidates = [idx for idx, char in enumerate(head) if char in boundary_chars and idx >= min_chars]
    if candidates:
        return head[: candidates[-1]].rstrip("；;。 ,，/／")
    sentence = re.split(r"[。；;]\s*", text, maxsplit=1)[0].strip("；;。 ,，")
    if min_chars <= len(sentence) <= max_chars:
        return sentence
    return head.rstrip("；;。 ,，")


def normalize_work_item_text(text: str, detail: str = "", allow_short: bool = False) -> str:
    text = sanitize_card_text(text)
    detail = sanitize_card_text(detail)
    if detail and detail not in text and len(text) < 20:
        text = f"{text}，{detail}"
    text = truncate_at_boundary(re.split(r"[。；;]\s*", text, maxsplit=1)[0], 60).strip("，,。；; ")
    if not allow_short and len(text) < 20 and detail and detail not in text:
        text = f"{text}，{detail}".rstrip("，,。；; ")
    return text


def item_limit(config: dict, key: str) -> int | None:
    value = config.get("card", {}).get(key)
    if value in (None, "", 0, "0", "none", "None", "null", "unlimited"):
        return None
    return max(1, int(value))


def limit_text(limit: int | None) -> str:
    return "不限制条数，按材料中的每一条事项分别生成" if limit is None else f"最多{limit}条"


def pick_lines(text: str, limit: int | None) -> list[str]:
    candidates = []
    for raw in re.split(r"[\n\r]+", text):
        line = clean_line(raw)
        if not line or set(line) <= {"|", "-"} or len(line) < 6:
            continue
        if line.startswith("|") and line.endswith("|"):
            cells = [clean_line(c) for c in line.strip("|").split("|")]
            line = "：".join(c for c in cells if c)[:90]
        candidates.append(line)
    return candidates if limit is None else candidates[:limit]


FIELD_LABELS = {
    "工作事项",
    "完成内容",
    "本期完成内容",
    "核心成果",
    "交付物",
    "相关文档/会议纪要",
    "业务价值",
    "当前状态",
    "项目/任务名称",
    "项目目标",
    "当前进度",
    "本期完成节点",
    "下一关键节点",
    "计划完成时间",
    "进度状态",
    "事项描述",
    "事项类型",
    "协同对象/责任人",
    "重点工作事项",
    "预期成果",
    "计划交付物",
    "优先级",
    "所需协同或资源",
    "AI/自动化应用场景",
    "使用的Skill或Workflow",
    "本期优化内容",
    "节省时间/提升效率",
    "形成的文档或链接",
    "是否具备复用价值",
    "建议沉淀类型",
    "后续优化计划",
}


def split_field(line: str) -> tuple[str, str] | None:
    match = re.match(r"^([^：:]{2,24})[：:]\s*(.*)$", clean_line(line))
    if not match:
        return None
    label = match.group(1).strip()
    if label not in FIELD_LABELS:
        return None
    return label, match.group(2).strip()


def is_structured_heading(line: str, next_lines: list[str]) -> bool:
    text = clean_line(line)
    if not text or split_field(text) or text.startswith("|") or len(text) < 4:
        return False
    if re.match(r"^(事项|项目|场景)\s*[一二三四五六七八九十0-9]+[：:]", text):
        return True
    return any(split_field(next_line) for next_line in next_lines if clean_line(next_line))


def split_structured_items(section: str) -> list[dict]:
    lines = [clean_line(line) for line in section.splitlines()]
    items = []
    current = None
    for idx, line in enumerate(lines):
        if not line:
            continue
        field = split_field(line)
        if field and field[0] in {"工作事项", "项目/任务名称", "事项描述", "重点工作事项", "AI/自动化应用场景"}:
            if current and not current["fields"]:
                current["title"] = field[1] or current.get("title") or field[0]
                current["fields"][field[0]] = field[1]
                continue
            if current:
                items.append(current)
            current = {"title": field[1] or field[0], "fields": {field[0]: field[1]}}
            continue
        if is_structured_heading(line, lines[idx + 1 : idx + 3]):
            if current:
                items.append(current)
            title = re.sub(r"^(事项|项目|场景)\s*[一二三四五六七八九十0-9]+[：:]\s*", "", line)
            current = {"title": title, "fields": {}}
            continue
        if current and field:
            current["fields"][field[0]] = field[1]
        elif current:
            current["fields"]["说明"] = (current["fields"].get("说明", "") + " " + line).strip()
    if current:
        items.append(current)
    return [item for item in items if clean_line(item.get("title", ""))]


def concise_detail(*values: str) -> str:
    text = next((clean_line(value) for value in values if clean_line(value)), "")
    if not text:
        return ""
    return truncate_at_boundary(re.split(r"[。；;]", text, maxsplit=1)[0], 48)


def card_item_from_structured(item: dict, detail_fields: tuple[str, ...]) -> dict:
    fields = item.get("fields", {})
    title = sanitize_card_text(item.get("title", ""))
    detail = concise_detail(*(fields.get(name, "") for name in detail_fields), fields.get("说明", ""))
    if not title:
        title = detail
    title = normalize_work_item_text(title, detail)
    return {"text": title, "label": title, "detail": ""}


def extracted_review_items(config: dict, report: str) -> list[dict]:
    max_review = item_limit(config, "max_review_items")
    sections = split_sections(report)
    core_section = sections.get("核心工作与成果", "") or sections.get("1", "")
    core_items = split_structured_items(core_section)
    items = [
        card_item_from_structured(item, ("核心成果", "完成内容", "本期完成内容", "当前状态"))
        for item in core_items
    ]
    if items:
        return normalize_card_items(items, max_review)
    review_base = core_section
    return normalize_card_items(pick_lines(review_base, max_review), max_review)


def extracted_today_items(config: dict, report: str, sources: dict) -> list[dict]:
    max_today = item_limit(config, "max_today_items")
    sections = split_sections(report)
    plan_section = (
        sections.get("未完成事项/代办/明日计划", "")
        or sections.get("5", "")
        or sections.get("4", "")
    )
    plan_items = split_structured_items(plan_section)
    items = [
        card_item_from_structured(item, ("预期成果", "计划交付物", "计划完成时间", "所需协同或资源"))
        for item in plan_items
    ]
    remaining = None if max_today is None else max(0, max_today - len(items))
    if (remaining is None or remaining > 0) and not items:
        take = 5 if remaining is None else remaining
        calendar_items = [compact_source_item(item) for item in sources["calendar"].get("items", [])[:take]]
        items.extend({"text": text, "label": text, "detail": ""} for text in calendar_items if text)
    return normalize_card_items(items, max_today)


def make_summary(card: dict) -> str:
    review = [item["label"] for item in card.get("review_items", []) if item.get("label")]
    today = [item["label"] for item in card.get("today_items", []) if item.get("label")]

    def first_complete(items: list[str], suffix: str, max_chars: int = 24) -> str:
        if not items:
            return ""
        first = truncate_at_boundary(sanitize_card_text(items[0]), max_chars)
        if len(items) > 1:
            return f"{first}等{len(items)}项{suffix}"
        return first

    review_text = first_complete(review, "工作")
    today_text = first_complete(today, "重点")
    if review_text and today_text:
        return f"昨日推进了{review_text}。今日重点关注{today_text}，继续推动关键事项闭环。"
    if review_text:
        return f"昨日推进了{review_text}，整体事项已有阶段性进展。今日继续围绕关键待办做好闭环。"
    return "昨日围绕重点工作事项推进并形成阶段性进展。今日继续聚焦关键待办，稳步推动事项闭环。"


def fallback_card(config: dict, date_info: dict, report: str, sources: dict) -> dict:
    max_today = item_limit(config, "max_today_items")
    max_review = item_limit(config, "max_review_items")
    today = extracted_today_items(config, report, sources)
    review = extracted_review_items(config, report)
    if not today:
        today = normalize_card_items(["聚焦昨日未完成工作事项并确认今日推进优先级"], max_today)
    if not review:
        review = normalize_card_items(["昨日围绕重点工作事项推进并完成阶段性整理"], max_review)
    card = {
        "title": f"{date_info['card_date_cn']}早报",
        "today_items": today,
        "review_items": review,
    }
    card["summary"] = make_summary(card)
    return card


def build_prompt(config: dict, date_info: dict, report: str, sources: dict) -> str:
    calendar_text = "\n".join(compact_source_item(item) for item in sources["calendar"].get("items", [])[:20])
    task_text = "\n".join(compact_source_item(item) for item in sources["tasks"].get("items", [])[:20])
    max_today = item_limit(config, "max_today_items")
    max_review = item_limit(config, "max_review_items")
    required_today = json.dumps(extracted_today_items(config, report, sources), ensure_ascii=False)
    required_review = json.dumps(extracted_review_items(config, report), ensure_ascii=False)
    sections = split_sections(report)
    work_only_report = "\n\n".join(
        part
        for part in (
            "## 核心工作与成果\n" + (sections.get("核心工作与成果", "") or sections.get("1", "")),
            "## 未完成事项/代办/明日计划\n"
            + (
                sections.get("未完成事项/代办/明日计划", "")
                or sections.get("5", "")
                or sections.get("4", "")
            ),
        )
        if part.strip()
    )
    return f"""请基于材料生成工作早报卡片 JSON。

硬性要求：
1. title 固定为：{date_info['card_date_cn']}早报
2. 只能读取【工作事项材料】、【今日事项清单】、【昨日事项清单】、【今日日程】、【今日代办】；不要读取或概括详细日报里的“协同、风险与所需支持”内容。
3. today_items {limit_text(max_today)}，优先逐条覆盖【今日事项清单】；每条只写工作事项本身，不写交付物、预期成果、当前状态等字段，格式为 {{\"text\":\"事项\"}}。
4. review_items {limit_text(max_review)}，必须逐条覆盖【昨日事项清单】；一条工作事项只能生成一条，不要拆成“工作事项/交付物/状态”等多条，也不要用第一条事项替代其他事项；每条只写工作事项本身，格式同上。
5. today_items 和 review_items 中每个事项尽量控制在 20-60 个中文字符，表达要自然完整；不要为了字数硬截断半句话，也不要长成完整段落。
6. 如果今日待办或今日日程是会议，只保留会议名称，不要加入时间、地点、参会人、会议链接、日程 JSON 字段或会议描述。
7. summary 用2-3句中文概括昨日工作，不超过120字，只概括工作事项，不写协同风险。
8. encouragement 结合昨日事项和今日重点写一句亲和、有趣、具体的鼓励语，不要名人名言，不超过44个中文字符，句式要自然，最多包含1个emoji；如需 emoji，只能从 🚀、😊、✨、🌟、💪 中选择。
9. 只输出 JSON：{{\"title\":\"...\",\"today_items\":[...],\"review_items\":[...],\"summary\":\"...\",\"encouragement\":\"...\"}}

【工作事项材料】
{work_only_report[:6000]}

【今日事项清单】
{required_today}

【昨日事项清单】
{required_review}

【今日日程】
{calendar_text[:3000]}

【今日代办】
{task_text[:2000]}
"""


def normalize_card_items(items, limit: int | None = None) -> list[dict]:
    normalized = []
    labels = "①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳"
    selected = items if limit is None else items[:limit]
    for idx, item in enumerate(selected):
        if isinstance(item, dict):
            text = normalize_work_item_text(
                str(item.get("text", "") or item.get("label", "") or item.get("title", "") or item.get("content", "") or f"事项{idx + 1}"),
                str(item.get("detail", "") or item.get("summary", "") or ""),
            )
        else:
            text = clean_line(str(item))
            if "：" in text:
                label, detail = text.split("：", 1)
            elif ":" in text:
                label, detail = text.split(":", 1)
            else:
                label, detail = truncate_at_boundary(text, 60), ""
            text = normalize_work_item_text(label, detail)
        index = labels[idx] if idx < len(labels) else f"{idx + 1}."
        text = text or f"事项{idx + 1}"
        normalized.append({"index": index, "text": text, "label": text, "detail": ""})
    return normalized


def make_encouragement(card: dict, date_info: dict) -> str:
    review = card.get("review_items", [])
    today = card.get("today_items", [])
    done = truncate_at_boundary(review[0]["label"], 28) if review else "关键事项"
    if len(review) > 1:
        done = f"{done}等{len(review)}项"
    next_task = truncate_at_boundary(today[0]["label"], 28) if today else "今日重点"
    templates = [
        "昨天把{done}往前推了一步，今天继续把{next}稳稳接住。",
        "{done}已经有进展啦，今天就让{next}再往前亮一下。",
        "昨天的{done}没白忙，今天带着这股劲儿拿下{next}。",
        "{done}这块已经起势，今天继续轻快推进{next}。",
        "昨天认真啃下{done}，今天给{next}也安排一个漂亮收尾。",
        "{done}有了眉目，今天继续稳住节奏，把{next}推进去。",
        "昨天给{done}打了底，今天顺手把{next}也照顾好。",
    ]
    idx = int(date_info["card_date"].replace("-", "")) % len(templates)
    return truncate_at_boundary(templates[idx].format(done=done, next=next_task), 60)


def limit_emoji_count(text: str, max_count: int = 1) -> str:
    kept = []
    count = 0
    for unit in grapheme_units(text):
        if any(is_emoji_char(ch) for ch in unit):
            if count >= max_count:
                continue
            count += 1
        kept.append(unit)
    return "".join(kept)


def validate_card(config: dict, date_info: dict, candidate: dict | None, report: str, sources: dict) -> dict:
    card = candidate if isinstance(candidate, dict) else fallback_card(config, date_info, report, sources)
    max_today = item_limit(config, "max_today_items")
    max_review = item_limit(config, "max_review_items")
    title = f"{date_info['card_date_cn']}早报"
    card["title"] = title
    extracted_today = extracted_today_items(config, report, sources)
    extracted_review = extracted_review_items(config, report)
    card["today_items"] = extracted_today or normalize_card_items(card.get("today_items", []), max_today) or fallback_card(config, date_info, report, sources)["today_items"]
    card["review_items"] = extracted_review or normalize_card_items(card.get("review_items", []), max_review) or fallback_card(config, date_info, report, sources)["review_items"]
    card["summary"] = make_summary(card)
    encouragement = clean_line(str(card.get("encouragement", "")))
    if not encouragement:
        encouragement = make_encouragement(card, date_info)
    card["encouragement"] = limit_emoji_count(encouragement, 1)[:70]
    card.pop("quote", None)
    return card


def choose_background(config: dict, date_info: dict, html_dir: Path) -> str:
    bg_dir = Path(config.get("card", {}).get("background_dir", "assets/scenery"))
    if not bg_dir.is_absolute():
        bg_dir = ROOT / bg_dir
    images = sorted(
        path
        for path in bg_dir.glob("scenery-*")
        if path.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}
    )
    if not images:
        return ""
    seed = int(date_info["card_date"].replace("-", ""))
    chosen = images[seed % len(images)]
    return Path(os.path.relpath(chosen, html_dir)).as_posix()


def choose_background_path(config: dict, date_info: dict) -> Path | None:
    bg_dir = Path(config.get("card", {}).get("background_dir", "assets/scenery"))
    if not bg_dir.is_absolute():
        bg_dir = ROOT / bg_dir
    images = sorted(
        path
        for path in bg_dir.glob("scenery-*")
        if path.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}
    )
    if not images:
        return None
    seed = int(date_info["card_date"].replace("-", ""))
    return images[seed % len(images)]


def weather_emoji(config: dict, date_info: dict) -> str:
    weather_conf = config.get("weather", {})
    if weather_conf.get("enabled", True) is False:
        return str(weather_conf.get("fallback_emoji", "☁️"))
    city = str(weather_conf.get("city", "Shanghai") or "Shanghai")
    fallback = str(weather_conf.get("fallback_emoji", "☁️") or "☁️")
    try:
        url = f"https://wttr.in/{parse.quote(city)}?format=j1"
        req = request.Request(url, headers={"User-Agent": "workday-morning-card/1.0"})
        with request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
        target = date_info.get("card_date", "")
        descriptions = []
        for day in data.get("weather", []):
            if day.get("date") == target:
                hourly = day.get("hourly", [])
                if hourly:
                    descriptions.extend(d.get("value", "") for d in hourly[len(hourly) // 2].get("weatherDesc", []))
                descriptions.extend(d.get("value", "") for d in day.get("weatherDesc", []))
        if not descriptions:
            descriptions.extend(d.get("value", "") for item in data.get("current_condition", []) for d in item.get("weatherDesc", []))
        desc = " ".join(descriptions).lower()
        if any(token in desc for token in ("rain", "drizzle", "shower", "thunder", "snow", "sleet")):
            return "🌧️"
        if any(token in desc for token in ("sunny", "clear")):
            return "☀️"
        return "☁️"
    except Exception:
        return fallback


def font(size: int, bold: bool = False):
    bundled_candidates = [
        ROOT / "assets" / "fonts" / "NotoSansSC-VF.ttf",
        ROOT / "assets" / "fonts" / "NotoSansCJKsc-Regular.otf",
        ROOT / "assets" / "fonts" / "SourceHanSansSC-Regular.otf",
    ]
    windows_candidates = [
        r"C:\Windows\Fonts\msyhbd.ttc" if bold else r"C:\Windows\Fonts\msyh.ttc",
        r"C:\Windows\Fonts\Dengb.ttf" if bold else r"C:\Windows\Fonts\Deng.ttf",
        r"C:\Windows\Fonts\NotoSansSC-VF.ttf",
        r"C:\Windows\Fonts\simhei.ttf" if bold else r"C:\Windows\Fonts\simkai.ttf",
    ]
    linux_candidates = [
        Path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"),
        Path("/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc") if bold else Path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"),
        Path("/usr/share/fonts/truetype/noto/NotoSansSC-Regular.ttf"),
        Path("/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc"),
        Path("/usr/share/fonts/truetype/wqy/wqy-microhei.ttc"),
        Path("/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc"),
        Path("/usr/share/fonts/truetype/arphic/ukai.ttc"),
        Path("/usr/share/fonts/truetype/arphic/uming.ttc"),
    ]
    mac_candidates = [
        Path("/System/Library/Fonts/PingFang.ttc"),
        Path("/System/Library/Fonts/STHeiti Light.ttc"),
        Path("/System/Library/Fonts/STHeiti Medium.ttc"),
        Path("/System/Library/Fonts/Supplemental/Songti.ttc"),
        Path("/System/Library/Fonts/Supplemental/Heiti.ttc"),
        Path("/System/Library/Fonts/Supplemental/Arial Unicode.ttf"),
        Path("/Library/Fonts/Arial Unicode.ttf"),
        Path("/Library/Fonts/NotoSansSC-VF.ttf"),
        Path("/Library/Fonts/NotoSansCJK-Regular.ttc"),
        Path.home() / "Library" / "Fonts" / "NotoSansSC-VF.ttf",
        Path.home() / "Library" / "Fonts" / "NotoSansCJK-Regular.ttc",
    ]
    if os.name == "nt":
        candidates = windows_candidates + bundled_candidates + mac_candidates + linux_candidates
    elif sys.platform == "darwin":
        candidates = mac_candidates + bundled_candidates + linux_candidates + windows_candidates
    else:
        candidates = bundled_candidates + linux_candidates + mac_candidates + windows_candidates
    for candidate in candidates:
        path = Path(candidate)
        if path.exists():
            loaded = ImageFont.truetype(str(path), size)
            if "NotoSansSC-VF" in path.name:
                try:
                    loaded.set_variation_by_name("Bold" if bold else "Medium")
                except Exception:
                    pass
            return loaded
    raise RuntimeError(
        "未找到可用中文字体，无法生成早报卡片。请随 Skill 打包 assets/fonts/NotoSansSC-VF.ttf，"
        "或在 OpenClaw 环境安装 Noto Sans CJK / WenQuanYi 中文字体。"
    )


EMOJI_ASSET_NAMES = {
    "☀": "sun.png",
    "☀️": "sun.png",
    "☁": "cloud.png",
    "☁️": "cloud.png",
    "🌧": "rain.png",
    "🌧️": "rain.png",
    "🚀": "rocket.png",
    "📌": "pin.png",
    "🧾": "receipt.png",
    "✨": "sparkles.png",
    "🌟": "star.png",
    "😊": "smile.png",
    "🙂": "slight_smile.png",
    "💪": "muscle.png",
    "🎉": "party.png",
    "🍀": "clover.png",
    "📝": "memo.png",
}


def normalize_emoji_key(text: str) -> str:
    return text.replace("\ufe0f", "")


def emoji_asset_path(text: str) -> Path | None:
    name = EMOJI_ASSET_NAMES.get(text) or EMOJI_ASSET_NAMES.get(normalize_emoji_key(text))
    if not name:
        return None
    path = ROOT / "assets" / "emoji" / name
    return path if path.exists() else None


def emoji_visual_size(fnt) -> int:
    return max(18, int(round(getattr(fnt, "size", 24))))


def emoji_advance(text: str, fnt) -> int:
    if emoji_asset_path(text):
        return emoji_visual_size(fnt)
    return emoji_visual_size(fnt)


def emoji_font(size: int):
    candidates = [
        r"C:\Windows\Fonts\seguiemj.ttf",
        r"C:\Windows\Fonts\Segoe UI Emoji.ttf",
        Path("/System/Library/Fonts/Apple Color Emoji.ttc"),
    ]
    for candidate in candidates:
        path = Path(candidate)
        if path.exists():
            return ImageFont.truetype(str(path), size)
    return font(size, True)


def text_width(draw: ImageDraw.ImageDraw, text: str, fnt) -> int:
    try:
        return int(math.ceil(draw.textlength(text, font=fnt)))
    except Exception:
        bbox = draw.textbbox((0, 0), text, font=fnt)
        return bbox[2] - bbox[0]


def fit_text(draw: ImageDraw.ImageDraw, text: str, fnt, max_width: int) -> str:
    if text_width(draw, text, fnt) <= max_width:
        return text
    ellipsis = "..."
    while text and text_width(draw, text + ellipsis, fnt) > max_width:
        text = text[:-1]
    return text + ellipsis if text else ellipsis


def wrap_text(draw: ImageDraw.ImageDraw, text: str, fnt, max_width: int, max_lines: int) -> list[str]:
    lines = []
    current = ""
    for char in text:
        trial = current + char
        if text_width(draw, trial, fnt) <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = char
            if len(lines) >= max_lines:
                break
    if current and len(lines) < max_lines:
        lines.append(current)
    if len(lines) == max_lines and text_width(draw, "".join(lines), fnt) < text_width(draw, text, fnt):
        lines[-1] = fit_text(draw, lines[-1], fnt, max_width)
    return lines


def wrap_text_mixed(draw: ImageDraw.ImageDraw, text: str, text_font, emoji_fnt, max_width: int, max_lines: int) -> list[str]:
    lines = []
    current = ""
    for unit in grapheme_units(text):
        trial = current + unit
        if text_width_mixed(draw, trial, text_font, emoji_fnt) <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = unit
            if len(lines) >= max_lines:
                break
    if current and len(lines) < max_lines:
        lines.append(current)
    if len(lines) == max_lines and text_width_mixed(draw, "".join(lines), text_font, emoji_fnt) < text_width_mixed(draw, text, text_font, emoji_fnt):
        lines[-1] = fit_text_mixed(draw, lines[-1], text_font, emoji_fnt, max_width)
    return lines


def rounded_mask(size: tuple[int, int], radius: int) -> Image.Image:
    mask = Image.new("L", size, 0)
    draw = ImageDraw.Draw(mask)
    draw.rounded_rectangle((0, 0, size[0], size[1]), radius=radius, fill=255)
    return mask


def draw_emoji(draw: ImageDraw.ImageDraw, xy: tuple[int, int], text: str, fnt) -> None:
    asset = emoji_asset_path(text)
    if asset:
        size = emoji_visual_size(fnt)
        img = Image.open(asset).convert("RGBA")
        bbox = img.getchannel("A").getbbox()
        if bbox:
            img = img.crop(bbox)
        img.thumbnail((size, size), Image.Resampling.LANCZOS)
        square = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        square.paste(img, ((size - img.width) // 2, (size - img.height) // 2), img)
        img = square
        draw._image.paste(img, xy, img)
        return
    try:
        draw.text(xy, text, font=fnt, embedded_color=True)
    except TypeError:
        draw.text(xy, text, font=fnt, fill=(255, 255, 255))


def aligned_emoji_y(draw: ImageDraw.ImageDraw, y: int, emoji: str, text_font, emoji_fnt) -> int:
    text_bbox = draw.textbbox((0, y), "早", font=text_font)
    text_center = (text_bbox[1] + text_bbox[3]) / 2
    if emoji_asset_path(emoji):
        return int(round(text_center - emoji_visual_size(emoji_fnt) / 2))
    emoji_bbox = draw.textbbox((0, 0), emoji, font=emoji_fnt)
    emoji_height = emoji_bbox[3] - emoji_bbox[1]
    return int(round(text_center - emoji_height / 2 - emoji_bbox[1]))


def is_emoji_char(char: str) -> bool:
    code = ord(char)
    if char in {"\ufe0f", "\u200d", "\u20e3"}:
        return True
    if 0x1F000 <= code <= 0x1FAFF:
        return True
    if 0x2600 <= code <= 0x27BF:
        return True
    return False


def grapheme_units(text: str) -> list[str]:
    units = []
    for char in text:
        if char in {"\ufe0f", "\u200d", "\u20e3"} or unicodedata.category(char).startswith("M"):
            if units:
                units[-1] += char
            else:
                units.append(char)
        else:
            units.append(char)
    return units


def text_width_mixed(draw: ImageDraw.ImageDraw, text: str, text_font, emoji_fnt) -> int:
    width = 0
    current = ""
    current_is_emoji = False
    for unit in grapheme_units(text):
        unit_is_emoji = any(is_emoji_char(ch) for ch in unit)
        if current and unit_is_emoji == current_is_emoji:
            current += unit
            continue
        if current:
            width += emoji_advance(current, emoji_fnt) if current_is_emoji else text_width(draw, current, text_font)
        current = unit
        current_is_emoji = unit_is_emoji
    if current:
        width += emoji_advance(current, emoji_fnt) if current_is_emoji else text_width(draw, current, text_font)
    return width


def draw_text_mixed(
    draw: ImageDraw.ImageDraw,
    xy: tuple[int, int],
    text: str,
    text_font,
    emoji_fnt,
    fill: tuple[int, int, int] = (255, 255, 255),
) -> int:
    x, y = xy
    current = ""
    current_is_emoji = False
    for unit in grapheme_units(text):
        unit_is_emoji = any(is_emoji_char(ch) for ch in unit)
        if current and unit_is_emoji == current_is_emoji:
            current += unit
            continue
        if current:
            fnt = emoji_fnt if current_is_emoji else text_font
            if current_is_emoji:
                draw_emoji(draw, (x, aligned_emoji_y(draw, y, current, text_font, fnt)), current, fnt)
            else:
                draw.text((x, y), current, font=fnt, fill=fill)
            x += emoji_advance(current, fnt) if current_is_emoji else text_width(draw, current, fnt)
        current = unit
        current_is_emoji = unit_is_emoji
    if current:
        fnt = emoji_fnt if current_is_emoji else text_font
        if current_is_emoji:
            draw_emoji(draw, (x, aligned_emoji_y(draw, y, current, text_font, fnt)), current, fnt)
        else:
            draw.text((x, y), current, font=fnt, fill=fill)
        x += emoji_advance(current, fnt) if current_is_emoji else text_width(draw, current, fnt)
    return x


def fit_text_mixed(draw: ImageDraw.ImageDraw, text: str, text_font, emoji_fnt, max_width: int) -> str:
    if text_width_mixed(draw, text, text_font, emoji_fnt) <= max_width:
        return text
    ellipsis = "..."
    units = grapheme_units(text)
    while units and text_width_mixed(draw, "".join(units) + ellipsis, text_font, emoji_fnt) > max_width:
        units.pop()
    return "".join(units) + ellipsis if units else ellipsis


def draw_icon_heading(
    draw: ImageDraw.ImageDraw,
    icon: str,
    text: str,
    xy: tuple[int, int],
    text_font,
    icon_font,
    fill: tuple[int, int, int],
) -> None:
    x, y = xy
    draw_emoji(draw, (x, aligned_emoji_y(draw, y, icon, text_font, icon_font)), icon, icon_font)
    icon_w = emoji_advance(icon, icon_font)
    draw_text_mixed(draw, (x + icon_w + 8, y), text, text_font, icon_font, fill)


def render_jpg(card: dict, date_info: dict, config: dict, out_path: Path) -> None:
    canvas_w = 1080
    card_w = 860
    card_y = 80
    radius = 56
    quote_rel_y = 110
    side_pad = 56

    title_font = font(40, True)
    quote_font = font(50, True)
    section_font = font(26, True)
    body_font = font(24)
    summary_font = font(24)
    title_emoji_font = emoji_font(40)
    quote_inline_emoji_font = emoji_font(50)
    body_emoji_font = emoji_font(24)
    heading_icon_font = emoji_font(25)

    measure_img = Image.new("RGB", (card_w, 1600), "#fff")
    measure_draw = ImageDraw.Draw(measure_img)
    max_text_w = card_w - side_pad * 2
    quote_text_w = max_text_w - 58
    quote_lines = wrap_text_mixed(measure_draw, card["encouragement"], quote_font, quote_inline_emoji_font, quote_text_w, 4)
    title_rel_y = quote_rel_y + max(1, len(quote_lines)) * 68 + 78
    content_rel_y = title_rel_y + 92

    def measure_section(items: list[dict], y_pos: int) -> int:
        y_pos += 38
        for item in items:
            line = f"{item['index']} {item.get('text') or item['label']}"
            y_pos += 35 * len(wrap_text_mixed(measure_draw, line, body_font, body_emoji_font, max_text_w, 4))
            y_pos += 8
        return y_pos + 12

    measured_y = content_rel_y
    measured_y = measure_section(card["today_items"], measured_y)
    measured_y = measure_section(card["review_items"], measured_y)
    measured_y += 38
    measured_y += 35 * len(wrap_text_mixed(measure_draw, card["summary"], summary_font, body_emoji_font, max_text_w, 4))
    card_h = max(1180, measured_y + 46)
    canvas_h = card_h + 200
    card_x = (canvas_w - card_w) // 2

    page = Image.new("RGB", (canvas_w, canvas_h), "#f4f4f5")
    shadow = Image.new("RGBA", (card_w + 80, card_h + 90), (0, 0, 0, 0))
    sd = ImageDraw.Draw(shadow)
    sd.rounded_rectangle((40, 28, 40 + card_w, 28 + card_h), radius=radius, fill=(40, 48, 52, 80))
    shadow = shadow.filter(ImageFilter.GaussianBlur(22))
    page.paste(shadow, (card_x - 40, card_y - 22), shadow)

    bg_path = choose_background_path(config, date_info)
    if bg_path and bg_path.exists():
        bg = Image.open(bg_path).convert("RGB")
    else:
        bg = Image.new("RGB", (card_w, card_h), "#dce7e5")

    base_img = ImageOps.fit(bg, (card_w, card_h), method=Image.Resampling.LANCZOS, centering=(0.5, 0.45)).convert("RGBA")
    blurred_img = base_img.filter(ImageFilter.GaussianBlur(10))

    blur_start = 650
    blur_full = 900
    blur_mask = Image.new("L", (card_w, card_h), 0)
    md = ImageDraw.Draw(blur_mask)
    for y in range(blur_start, card_h):
        progress = min(1.0, max(0.0, (y - blur_start) / (blur_full - blur_start)))
        eased = progress * progress * (3 - 2 * progress)
        md.line((0, y, card_w, y), fill=int(160 * eased))

    card_img = Image.composite(blurred_img, base_img, blur_mask)

    tint = Image.new("RGBA", (card_w, card_h), (0, 0, 0, 0))
    td = ImageDraw.Draw(tint)
    for y in range(0, card_h):
        progress = min(1.0, y / max(1, card_h - 1))
        alpha = int(105 + 72 * progress)
        td.line((0, y, card_w, y), fill=(0, 0, 0, alpha))
    card_img.alpha_composite(tint)

    page.paste(card_img, (card_x, card_y), card_img)

    draw = ImageDraw.Draw(page)

    left = card_x + side_pad
    right = card_x + card_w - side_pad
    quote_y = card_y + quote_rel_y
    for idx, line in enumerate(quote_lines):
        draw_text_mixed(
            draw,
            (left, quote_y),
            line,
            quote_font,
            quote_inline_emoji_font,
            (255, 255, 255),
        )
        quote_y += 68

    title = card["title"]
    title_y = card_y + title_rel_y
    title_weather = weather_emoji(config, date_info)
    title_gap = text_width(draw, "早", title_font)
    title_text_x = left + emoji_advance(title_weather, title_emoji_font) + title_gap
    draw_emoji(draw, (left, aligned_emoji_y(draw, title_y, title_weather, title_font, title_emoji_font)), title_weather, title_emoji_font)
    title_text = fit_text_mixed(draw, title, title_font, title_emoji_font, right - title_text_x)
    draw_text_mixed(draw, (title_text_x, title_y), title_text, title_font, title_emoji_font, (255, 255, 255))

    x = left
    y = card_y + content_rel_y
    max_text_w = right - left

    def draw_section(icon: str, title_text: str, items: list[dict], y_pos: int) -> int:
        draw_icon_heading(draw, icon, title_text, (x, y_pos), section_font, heading_icon_font, (255, 255, 255))
        y_pos += 38
        for item in items:
            line = f"{item['index']} {item.get('text') or item['label']}"
            for wrapped in wrap_text_mixed(draw, line, body_font, body_emoji_font, max_text_w, 4):
                draw_text_mixed(draw, (x, y_pos), wrapped, body_font, body_emoji_font, (246, 248, 249))
                y_pos += 35
            y_pos += 8
        return y_pos + 12

    y = draw_section("📌", "今日重要事项", card["today_items"], y)
    y = draw_section("🧾", "昨日事项回顾", card["review_items"], y)
    draw_icon_heading(draw, "✨", "昨日工作总结", (x, y), section_font, heading_icon_font, (255, 255, 255))
    y += 38
    for line in wrap_text_mixed(draw, card["summary"], summary_font, body_emoji_font, max_text_w, 4):
        draw_text_mixed(draw, (x, y), line, summary_font, body_emoji_font, (246, 248, 249))
        y += 35

    out_path.parent.mkdir(parents=True, exist_ok=True)
    final_card = page.crop((card_x, card_y, card_x + card_w, card_y + card_h))
    final_card.save(out_path, format="JPEG", quality=94, optimize=True)


def should_send(args, config: dict) -> bool:
    if args.no_send:
        return False
    if args.send:
        return True
    return bool(config.get("delivery", {}).get("enabled", False))


def send_card_via_lark_bot(card_path: Path, date_info: dict, config: dict) -> dict:
    delivery = config.get("delivery", {})
    if not card_path.exists():
        raise RuntimeError(f"卡片图片不存在，无法发送: {card_path}")

    as_identity = str(delivery.get("as", "bot") or "bot")
    user_id = str(delivery.get("user_id", "") or "").strip()
    chat_id = str(delivery.get("chat_id", "") or "").strip()
    if user_id in {"ou_xxx", "ou_"} or chat_id in {"oc_xxx", "oc_"}:
        raise RuntimeError("delivery.user_id/chat_id 仍是占位符，请先在 config.json 中填写真实飞书 open_id 或 chat_id")
    if bool(user_id) == bool(chat_id):
        raise RuntimeError("delivery.user_id 和 delivery.chat_id 必须且只能配置一个")

    idempotency_prefix = re.sub(r"[^A-Za-z0-9_-]+", "-", str(delivery.get("idempotency_prefix", "wmc") or "wmc")).strip("-")[:18] or "wmc"
    target_hash = hashlib.sha1((user_id or chat_id).encode("utf-8")).hexdigest()[:10]
    idempotency_key = f"{idempotency_prefix}-{date_info['card_date'].replace('-', '')}-{target_hash}"
    command = [
        resolve_lark_cli(),
        "im",
        "+messages-send",
        "--as",
        as_identity,
        "--image",
        f".{os.sep}{card_path.name}",
        "--idempotency-key",
        idempotency_key,
        "--json",
    ]
    if user_id:
        command.extend(["--user-id", user_id])
    else:
        command.extend(["--chat-id", chat_id])

    rendered = subprocess.list2cmdline(command)
    result = subprocess.run(
        rendered,
        cwd=str(card_path.parent),
        shell=True,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=int(delivery.get("timeout_seconds", 180) or 180),
    )
    parsed = parse_json(result.stdout)
    payload = {
        "ok": result.returncode == 0,
        "returncode": result.returncode,
        "identity": as_identity,
        "target_type": "user_id" if user_id else "chat_id",
        "target": user_id or chat_id,
        "idempotency_key": idempotency_key,
        "lark_cli": command[0],
        "openclaw_agent_id": os.environ.get("OPENCLAW_AGENT_ID", ""),
        "openclaw_agent_dir": os.environ.get("OPENCLAW_AGENT_DIR", ""),
        "send_cwd": str(card_path.parent),
        "stdout": result.stdout[-8000:],
        "stderr": result.stderr[-8000:],
        "json": parsed,
    }
    if result.returncode != 0:
        raise RuntimeError(f"飞书机器人发送早报卡片失败: {payload}")
    return payload


def render_html(card: dict, date_info: dict, config: dict, html_dir: Path) -> str:
    background_url = choose_background(config, date_info, html_dir)
    blur_px = int(config.get("card", {}).get("background_blur_px", 10))
    dim = float(config.get("card", {}).get("background_dim", 0.26))

    def items_html(items):
        blocks = []
        for item in items:
            blocks.append(
                f"""<li><span class="idx">{html.escape(item['index'])}</span><div><b>{html.escape(item.get('text') or item['label'])}</b></div></li>"""
            )
        return "\n".join(blocks)

    bg_style = (
        f"background-image: url('{html.escape(background_url)}');"
        if background_url
        else "background-image: linear-gradient(145deg, #dff3ec, #dcecff 58%, #fff3d2);"
    )

    return f"""<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(card['title'])}</title>
<style>
  :root {{
    --paper: rgba(255, 255, 255, .72);
    --paper-soft: rgba(255, 255, 255, .44);
    --line: rgba(255, 255, 255, .42);
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, .82);
    --shadow: rgba(18, 36, 44, .32);
  }}
  * {{ box-sizing: border-box; }}
  body {{
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 28px;
    background: #f5f4f6;
    font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
    color: var(--ink);
  }}
  .card {{
    position: relative;
    width: min(440px, calc(100vw - 32px));
    min-height: 760px;
    border: 12px solid rgba(255, 255, 255, .94);
    border-radius: 48px;
    box-shadow: 0 28px 80px rgba(35, 44, 53, .22);
    overflow: hidden;
    isolation: isolate;
    {bg_style}
    background-size: cover;
    background-position: center;
  }}
  .card::before {{
    content: "";
    position: absolute;
    inset: -3px;
    z-index: -3;
    {bg_style}
    background-size: cover;
    background-position: center;
    filter: saturate(.92) brightness(.98);
    transform: scale(1.02);
  }}
  .card::after {{
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(255,255,255,.08) 0%, rgba(20,31,38,.18) 42%, rgba(12,18,22,.70) 100%),
      rgba(255,255,255,{dim});
  }}
  .content {{
    min-height: 760px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 34px 28px 74px;
    text-shadow: 0 2px 18px rgba(0,0,0,.22);
  }}
  header {{ margin-bottom: 18px; }}
  h1 {{
    margin: 0;
    max-width: 100%;
    font-size: 24px;
    line-height: 1.16;
    letter-spacing: 0;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }}
  .encouragement {{
    margin-top: 8px;
    color: rgba(235, 238, 240, .86);
    font-size: 12.5px;
    line-height: 1.45;
    font-weight: 600;
    text-shadow: 0 2px 12px rgba(0,0,0,.28);
  }}
  .panel {{
    padding: 18px 17px 16px;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(235,238,240,.42), rgba(196,202,207,.30));
    border: 1px solid rgba(255,255,255,.34);
    backdrop-filter: blur({blur_px}px) saturate(1.2);
    box-shadow: 0 18px 48px rgba(0,0,0,.18);
  }}
  section + section {{ margin-top: 14px; }}
  h2 {{
    margin: 0 0 9px;
    font-size: 15px;
    line-height: 1.3;
    color: rgba(255,255,255,.98);
    letter-spacing: 0;
  }}
  ul {{ list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; }}
  li {{
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 8px;
    align-items: start;
  }}
  .idx {{
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, .30);
    color: #fff;
    font-weight: 700;
    font-size: 12px;
  }}
  b {{ font-size: 13px; color: rgba(255,255,255,.98); }}
  p {{
    margin: 2px 0 0;
    line-height: 1.45;
    color: rgba(255,255,255,.92);
    font-size: 12px;
  }}
  .summary {{
    line-height: 1.55;
    color: rgba(255,255,255,.94);
    font-size: 12.5px;
  }}
  @media (max-width: 480px) {{
    body {{ padding: 16px; }}
    .card {{ min-height: 720px; border-radius: 40px; }}
    .content {{ min-height: 720px; padding: 30px 22px 58px; }}
    h1 {{ font-size: 22px; }}
  }}
</style>
</head>
<body>
  <article class="card">
    <div class="content">
      <header>
        <h1>🌤️ {html.escape(card['title'])}</h1>
        <div class="encouragement">{html.escape(card['encouragement'])}</div>
      </header>
      <main class="panel">
        <section>
          <h2>🍀 1. 今日重要事项</h2>
          <ul>{items_html(card['today_items'])}</ul>
        </section>
        <section>
          <h2>✨ 2. 昨日事项回顾</h2>
          <ul>{items_html(card['review_items'])}</ul>
        </section>
        <section>
          <h2>📝 3. 昨日工作总结</h2>
          <div class="summary">{html.escape(card['summary'])}</div>
        </section>
      </main>
    </div>
  </article>
</body>
</html>
"""


def main():
    bootstrap_openclaw_agent_env()
    args = parse_args()
    config = load_config(args.config)
    date_info = dates(args, config)
    out_dir = output_dir(config, date_info["card_date"], args.run_dir)

    report, report_meta = read_report_from_sheet(config, date_info)
    sources = collect_today_sources(config, date_info)
    prompt = build_prompt(config, date_info, report, sources)
    candidate = call_llm(config, prompt)
    card = validate_card(config, date_info, candidate, report, sources)

    (out_dir / "source_report.txt").write_text(report, encoding="utf-8")
    (out_dir / "raw_sources.json").write_text(
        json.dumps({"date": date_info, "report_meta": report_meta, "sources": sources}, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    (out_dir / "card_data.json").write_text(json.dumps(card, ensure_ascii=False, indent=2), encoding="utf-8")
    card_path = out_dir / "card.jpg"
    render_jpg(card, date_info, config, card_path)
    print(card_path)

    if should_send(args, config):
        delivery_result = send_card_via_lark_bot(card_path, date_info, config)
        (out_dir / "delivery_result.json").write_text(json.dumps(delivery_result, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"sent:{delivery_result.get('target_type')}:{delivery_result.get('target')}")

    if args.open or config.get("card", {}).get("open_after_generate", False):
        webbrowser.open(str(card_path))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)

